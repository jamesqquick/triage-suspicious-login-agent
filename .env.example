# Cloudflare API token with `Intel Read` and `Access: Audit Logs Read`.
CF_API_TOKEN=
# Your Cloudflare account ID.
CF_ACCOUNT_ID=

# Slack is configured after deploy, so its two variables are deliberately absent
# here: every key in this file becomes a *required* field on the Deploy to
# Cloudflare setup page, and you have no Slack app yet at that point. Add them as
# Worker secrets once the app exists (`wrangler secret put <NAME>`):
#
#   SLACK_BOT_TOKEN       xoxb-... token with the `chat:write` scope. If it is set
#                         but the post fails, the report tool returns
#                         delivered: "failed" with the error and the full report —
#                         delivery is never silently downgraded.
#   SLACK_SIGNING_SECRET  Verifies incoming webhooks. When it is unset the Slack
#                         ingress is not mounted and /channels/slack/* returns 503.
#
# Both are optional locally: with neither set, running the agent returns the
# report as run output instead of posting to a thread.

# MODEL is also deliberately absent here for the same reason: it is already
# hardcoded as a plain `var` in wrangler.jsonc (MODEL=cloudflare/openai/gpt-4o),
# so the deployed Worker needs no input for it. Locally, `vite dev` picks up
# that same wrangler.jsonc value automatically — no .env entry needed. Only add
# MODEL=<provider>/<model> to your own .env if you want to override it (e.g. to
# use a different provider directly), and set that provider's own API key
# alongside it.
