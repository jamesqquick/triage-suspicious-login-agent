# Cloudflare API token with `Account Intel: Read` and `Access: Audit Logs: Read`.
CF_API_TOKEN=
# Your Cloudflare account ID.
CF_ACCOUNT_ID=

# Slack bot token (xoxb-...) with the `chat:write` scope. Without it, reports fall
# back to run output instead of posting to the thread.
SLACK_BOT_TOKEN=
# Slack signing secret. Webhook verification fails closed when this is unset.
SLACK_SIGNING_SECRET=
