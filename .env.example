# Cloudflare API token with `Intel Read` and `Access: Audit Logs Read`.
CF_API_TOKEN=
# Your Cloudflare account ID.
CF_ACCOUNT_ID=

# Slack bot token (xoxb-...) with the `chat:write` scope. If it is set but the post
# fails, the report tool returns delivered: "failed" with the error and the full
# report — delivery is never silently downgraded.
SLACK_BOT_TOKEN=
# Slack signing secret. Webhook verification fails closed when this is unset.
SLACK_SIGNING_SECRET=
